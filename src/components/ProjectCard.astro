---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectVisual from './ProjectVisual.astro';
import { sitePath } from '../utils/urls';

interface Props {
  project: CollectionEntry<'projects'>;
  showTopics?: boolean;
}

const { project, showTopics = true } = Astro.props;
const mediaClass = [
  'project-media',
  project.data.imageFit === 'contain' ? 'media-contain' : '',
].filter(Boolean).join(' ');
---

<article
  class="project-card"
  data-filter-item
  data-category={project.data.category.toLowerCase()}
  data-search={`${project.data.title} ${project.data.shortSummary} ${project.data.topics.join(' ')}`.toLowerCase()}
>
  <a class="project-card-visual" href={sitePath(`/projects/${project.id}/`)} tabindex="-1" aria-hidden="true">
    {project.data.image ? (
      project.data.image.format === 'svg' ? (
        <Image
          class={mediaClass}
          src={project.data.image}
          alt={project.data.imageAlt ?? ''}
          width={project.data.image.width}
          height={project.data.image.height}
          loading="lazy"
        />
      ) : (
        <Image
          class={mediaClass}
          src={project.data.image}
          alt={project.data.imageAlt ?? ''}
          widths={[320, 640, 960]}
          sizes="(max-width: 48rem) calc(100vw - 2rem), 36rem"
          loading="lazy"
        />
      )
    ) : (
      <ProjectVisual type={project.data.visual ?? 'matrix'} />
    )}
  </a>
  <div class="project-card-body">
    <h3><a href={sitePath(`/projects/${project.id}/`)}>{project.data.title}</a></h3>
    <p>{project.data.shortSummary}</p>
    {showTopics && project.data.topics.length > 0 && (
      <div class="project-card-footer">
        <div class="tag-row" aria-label="Topics">
          {project.data.topics.slice(0, 2).map((topic) => <span class="tag">{topic}</span>)}
        </div>
      </div>
    )}
  </div>
</article>
