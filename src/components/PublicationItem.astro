---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../utils/urls';

interface Props {
  publication: CollectionEntry<'publications'>;
  compact?: boolean;
}

const { publication, compact = false } = Astro.props;
const { data } = publication;
const links = [
  data.paperUrl ? { label: 'Paper', href: data.paperUrl } : undefined,
  data.arxivUrl && data.arxivUrl !== data.paperUrl
    ? { label: 'arXiv', href: data.arxivUrl }
    : undefined,
  data.codeUrl ? { label: 'Code', href: data.codeUrl } : undefined,
  data.projectUrl ? { label: 'Project', href: data.projectUrl } : undefined,
].filter((link): link is { label: string; href: string } => Boolean(link));
---

<article
  class:list={['publication-item', { compact }]}
  data-filter-item
  data-type={data.publicationType.toLowerCase()}
  data-topics={data.tags.join(' ').toLowerCase()}
>
  <div class="publication-year">{data.year ?? '—'}</div>
  <div class="publication-content">
    <div class="publication-meta">
      <span>{data.publicationType}</span>
      {data.venue && <span>{data.venue}</span>}
      {data.status && data.status !== data.publicationType && <span>{data.status}</span>}
    </div>
    <h3>{data.title}</h3>
    {data.authors.length > 0 && (
      <p class="publication-authors">
        {data.authors.map((author, index) => (
          <>
            <span class:list={{ 'author-self': author === 'Ivan Ilin' }}>{author}</span>
            {index < data.authors.length - 1 && ', '}
          </>
        ))}
      </p>
    )}
    {!compact && data.summary && <p>{data.summary}</p>}
    <div class="publication-actions">
      {links.map((link) => (
        <a class="text-link" href={sitePath(link.href)} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
          {link.label}<span aria-hidden="true"> ↗</span>
        </a>
      ))}
      {data.bibtex && (
        <button class="copy-button" type="button" data-copy-bibtex data-bibtex={data.bibtex}>
          Copy BibTeX
        </button>
      )}
    </div>
  </div>
</article>
