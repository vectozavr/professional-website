---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { id, eyebrow, title, description, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && linkLabel && (
    <a class="text-link section-link" href={href}>
      {linkLabel}<span aria-hidden="true"> ↗</span>
    </a>
  )}
</div>
