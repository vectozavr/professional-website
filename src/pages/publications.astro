---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { researchProfileLinks } from '../data/profile';
import { sitePath } from '../utils/urls';

const publications = (await getCollection('publications')).sort(
  (a, b) =>
    (b.data.year ?? 0) - (a.data.year ?? 0) ||
    a.data.title.localeCompare(b.data.title),
);

const structuredData = publications.map((publication) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: publication.data.title,
  author: publication.data.authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: publication.data.year?.toString(),
  isPartOf: publication.data.venue
    ? { '@type': 'CreativeWorkSeries', name: publication.data.venue }
    : undefined,
  url: publication.data.paperUrl || publication.data.arxivUrl || undefined,
  abstract: publication.data.summary,
  keywords: publication.data.tags,
}));
---

<BaseLayout
  title="Publications"
  description="Verified publications and preprints by Ivan Ilin on efficient machine learning, optimization, compression, and distributed training."
  structuredData={structuredData}
>
  <section class="content-section publications-index">
    <div class="shell">
      <a class="button secondary page-back-button" href={sitePath('/')}>
        <span aria-hidden="true">←</span> Back to the main page
      </a>
      <header class="publications-intro">
        <h1>Publications</h1>
        <p>My complete publication list, newest first.</p>
      </header>
      <nav class="publication-profile-links" aria-label="Research profiles">
        {researchProfileLinks.map((link) => (
          <a
            class="profile-link"
            href={link.href}
            target="_blank"
            rel="me noreferrer"
          >
            <span class="profile-link-label">
              {link.icon && (
                <img
                  class="profile-link-icon"
                  src={sitePath(link.icon)}
                  alt=""
                  width="18"
                  height="18"
                  aria-hidden="true"
                />
              )}
              <span>{link.label}</span>
            </span>
          </a>
        ))}
      </nav>
      <div class="publication-list">
        {publications.map((publication) => (
          <PublicationItem
            publication={publication}
            compact
            showSummary
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-bibtex]').forEach((button) => {
    button.addEventListener('click', async () => {
      const bibtex = button.dataset.bibtex;
      if (!bibtex) return;
      try {
        await navigator.clipboard.writeText(bibtex);
        button.textContent = 'Copied';
      } catch {
        const field = document.createElement('textarea');
        field.value = bibtex;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.inset = '0 auto auto -9999px';
        document.body.append(field);
        field.select();
        const legacyCopy = (
          document as unknown as { execCommand(command: string): boolean }
        ).execCommand.bind(document);
        button.textContent = legacyCopy('copy') ? 'Copied' : 'Copy failed';
        field.remove();
      }
      window.setTimeout(() => {
        button.textContent = 'Copy BibTeX';
      }, 1600);
    });
  });
</script>
