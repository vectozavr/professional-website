---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { getRepositoryMetric } from '../../data/metrics';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const publications = await getCollection('publications');
const relatedPublications = publications.filter((publication) =>
  project.data.relatedPublications.includes(publication.id),
);
const metric = getRepositoryMetric(project.data.metricsRepository);
const mediaClass = [
  'project-media',
  project.data.imageFit === 'contain' ? 'media-contain' : '',
].filter(Boolean).join(' ');
const links = [
  project.data.githubUrl ? { label: 'GitHub repository', href: project.data.githubUrl } : undefined,
  project.data.paperUrl ? { label: 'Read the paper', href: project.data.paperUrl } : undefined,
  project.data.demoUrl ? { label: 'Visit project', href: project.data.demoUrl } : undefined,
].filter((link): link is { label: string; href: string } => Boolean(link));

const isSoftware = Boolean(project.data.githubUrl);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': isSoftware ? 'SoftwareSourceCode' : 'CreativeWork',
  name: project.data.title,
  description: project.data.shortSummary,
  url: new URL(`/projects/${project.id}/`, Astro.site),
  author: { '@type': 'Person', name: 'Ivan Ilin' },
  dateCreated: project.data.year?.toString(),
  codeRepository: project.data.githubUrl || undefined,
  keywords: project.data.topics,
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.shortSummary}
  structuredData={structuredData}
>
  <header class="detail-hero shell">
    <div>
      <a class="back-link" href="/projects/">← All projects</a>
      <p class="eyebrow">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p class="detail-summary">{project.data.shortSummary}</p>
      <div class="detail-meta">
        <span>{project.data.status}</span>
        {project.data.year && <span>{project.data.year}</span>}
        {metric && <span>★ {metric.stars} GitHub stars</span>}
      </div>
      {links.length > 0 && (
        <div class="detail-actions">
          {links.map((link, index) => (
            <a class:list={['button', { secondary: index > 0 }]} href={link.href} target="_blank" rel="noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
    <div class="detail-visual">
      {project.data.image ? (
        <Image
          class={mediaClass}
          src={project.data.image}
          alt={project.data.imageAlt ?? ''}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 62rem) calc(100vw - 2.5rem), 42rem"
          loading="eager"
        />
      ) : (
        <ProjectVisual type={project.data.visual ?? 'matrix'} />
      )}
    </div>
  </header>

  <section class="project-body content-section">
    <div class="narrow-shell">
      {project.data.youtubeVideoId && (
        <div class="project-video-frame">
          <iframe
            class="project-video"
            src={`https://www.youtube-nocookie.com/embed/${project.data.youtubeVideoId}`}
            title={`${project.data.title} video overview`}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      )}
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  {relatedPublications.length > 0 && (
    <section class="content-section subtle">
      <div class="shell">
        <p class="eyebrow">Related work</p>
        <h2>Publications</h2>
        <div class="publication-list">
          {relatedPublications.map((publication) => <PublicationItem publication={publication} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
