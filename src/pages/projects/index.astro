---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { researchProfileLinks, socialMediaLinks } from '../../data/profile';
import { sitePath } from '../../utils/urls';

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.title.localeCompare(b.data.title),
);
const vectozavrAcademyIndex = projects.findIndex(
  (project) => project.id === 'vectozavr-academy',
);
if (vectozavrAcademyIndex >= 0) {
  const [vectozavrAcademy] = projects.splice(vectozavrAcademyIndex, 1);
  const voiceCutIndex = projects.findIndex((project) => project.id === 'voicecut');

  if (vectozavrAcademy) {
    projects.splice(voiceCutIndex >= 0 ? voiceCutIndex + 1 : 0, 0, vectozavrAcademy);
  }
}
const projectProfileLinks = [
  ...researchProfileLinks,
  ...socialMediaLinks.filter((link) => link.label === 'YouTube'),
];
---

<BaseLayout
  title="Projects"
  description="Research, open-source software, engineering, hardware, and educational projects by Ivan Ilin."
>
  <header class="page-hero projects-hero shell">
    <div class="page-hero-content">
      <a class="button secondary page-back-button" href={sitePath('/')}>
        <span aria-hidden="true">←</span> Back to the main page
      </a>
      <h1>Research made concrete</h1>
      <p class="page-intro">
        Research implementations, open-source tools, engineering builds, and
        educational projects. Each page preserves public code, articles, videos, and
        project links.
      </p>
      <nav class="page-profile-links" aria-label="Project and research profiles">
        {projectProfileLinks.map((link) => (
          <a
            class="profile-link"
            href={link.href}
            target="_blank"
            rel="me noreferrer"
          >
            <span class="profile-link-label">
              {link.icon && (
                <img
                  class="profile-link-icon"
                  src={sitePath(link.icon)}
                  alt=""
                  width="18"
                  height="18"
                  aria-hidden="true"
                />
              )}
              <span>{link.label}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </header>

  <section class="content-section projects-index">
    <div class="shell">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
